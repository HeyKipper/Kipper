# Copy to .env.local and fill in. Values are safe to expose to the browser:
# the publishable key only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Twilio credentials are NOT set here. They live in the Supabase dashboard
# under Authentication > Sign In / Providers > Phone, because Supabase Auth
# calls Twilio Verify server-side on our behalf. See docs/AUTH.md.
